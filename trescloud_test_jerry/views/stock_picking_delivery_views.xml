<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_inherit_view" model="ir.ui.view">
        <field name="name">stock.picking.inherit.view</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                    </group>
                    <field name="move_line_ids">
                        <tree editable="bottom" create="false">
                            <field name="product_uom_qty"/>
                            <field name="product_uom"/>
                        </tree>
                </sheet>
            </form>
        </field>
    </record>
    <record id="stock_picking_inherit_tree_view" model="ir.ui.view">
        <field name="name">stock.picking.inherit.tree.view</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="scheduled_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
</odoo>
         